<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#100d22">
<title>For Sanvi ✦ A Little Birthday Universe</title>
<style>
:root{--night:#100d22;--plum:#211632;--pink:#ff9fc9;--rose:#f5c0d8;--cream:#fff7f4;--muted:#c9b7c9;--gold:#f5d99b}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--night);color:var(--cream);font-family:Georgia,'Times New Roman',serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-2;background:radial-gradient(ellipse at 15% 10%,#53315d 0,transparent 38%),radial-gradient(ellipse at 85% 35%,#33244f 0,transparent 42%),linear-gradient(150deg,#100d22,#1c122c 55%,#100d22)}
#stars{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}.star{position:absolute;width:2px;height:2px;border-radius:50%;background:#fff4d9;opacity:.6;animation:twinkle 3s infinite ease-in-out alternate}@keyframes twinkle{to{opacity:.12;transform:scale(.5)}}
nav{position:absolute;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:25px clamp(20px,6vw,80px);font:12px Arial,sans-serif;letter-spacing:2px;text-transform:uppercase;color:#e8cfe0}.brand{color:var(--gold)}nav a{color:inherit;text-decoration:none}
.hero{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:100px 22px 70px;position:relative}
.eyebrow{font:11px Arial,sans-serif;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:24px}
h1{font-size:clamp(58px,12vw,120px);line-height:.9;font-weight:400;letter-spacing:-4px;margin:0;background:linear-gradient(110deg,#fff7f4 15%,#ffc2db 52%,#f6dca4 90%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 15px 60px #ff9fc922}
.subtitle{font-size:clamp(17px,3vw,23px);font-style:italic;color:#e4cddd;margin:25px 0 36px}.sparkle{color:var(--gold)}
.primary{border:1px solid #f7c4d8;background:linear-gradient(120deg,#f4a4c9,#d77db4);color:#29172b;border-radius:50px;padding:16px 27px;font:600 12px Arial,sans-serif;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;box-shadow:0 12px 35px #d77db433;transition:.25s}.primary:hover{transform:translateY(-3px);box-shadow:0 17px 45px #d77db455}
.scroll{position:absolute;bottom:26px;color:#c9b7c9;font:10px Arial,sans-serif;letter-spacing:3px;text-transform:uppercase}
section{padding:90px 22px}.section-inner{max-width:980px;margin:auto}.kicker{font:10px Arial,sans-serif;letter-spacing:3px;text-transform:uppercase;color:var(--gold);text-align:center}.section-title{text-align:center;font-size:clamp(34px,6vw,57px);font-weight:400;margin:15px 0 14px}.section-copy{text-align:center;color:var(--muted);font-size:17px;line-height:1.7;max-width:620px;margin:0 auto 42px}
.glass{background:linear-gradient(135deg,#ffffff12,#ffffff06);border:1px solid #ffffff20;border-radius:28px;box-shadow:0 25px 70px #05030c55;backdrop-filter:blur(12px)}
.cake-card{max-width:700px;margin:0 auto;padding:38px 24px 34px;text-align:center;position:relative;overflow:hidden}.cake-card:before{content:"";position:absolute;width:250px;height:250px;border-radius:50%;background:#e58bb522;filter:blur(30px);left:calc(50% - 125px);top:35px}
.cake{position:relative;width:190px;height:170px;margin:8px auto 24px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;filter:drop-shadow(0 20px 18px #0007)}
.candle{position:absolute;top:0;width:8px;height:35px;border-radius:4px;background:repeating-linear-gradient(135deg,#f8dca4 0 5px,#f39dc7 5px 10px);z-index:4}
.flame{position:absolute;top:-17px;left:1px;width:7px;height:13px;background:radial-gradient(ellipse at 50% 70%,#fff8b0 0 20%,#ffad56 55%,transparent 72%);border-radius:60% 40% 60% 40%;animation:flicker .7s infinite alternate}
@keyframes flicker{to{transform:rotate(9deg) scale(.85)}}
.tier{position:relative;border:1px solid #a7a9e8;border-radius:9px 9px 13px 13px;background:linear-gradient(110deg,#171b4d,#343a7b 48%,#171b4d);box-shadow:inset 0 5px 9px #ffffff22,0 8px 12px #0005}
.tier.top{width:78px;height:44px}.tier.mid{width:118px;height:48px}.tier.base{width:160px;height:54px}
.tier:after{content:"✦　·　✧　·　✦";position:absolute;inset:13px 0 auto;text-align:center;color:#e4d7ff;font-size:10px;white-space:nowrap}
.cake-off .flame{display:none}.cake-note{color:var(--muted);font:12px Arial,sans-serif;letter-spacing:1px}
.message-card{max-width:760px;margin:0 auto;padding:clamp(28px,6vw,58px);text-align:center;position:relative}
.message-card .quote{font-size:clamp(23px,4vw,36px);line-height:1.45;font-style:italic;color:#fff0f5}.signature{color:var(--gold);font-size:16px;margin-top:26px}
.bunnies{display:flex;justify-content:center;gap:18px;margin:5px auto 25px}.bunny{font-size:70px;filter:drop-shadow(0 10px 12px #0005);animation:bob 3s ease-in-out infinite}.bunny:nth-child(2){animation-delay:.7s}@keyframes bob{50%{transform:translateY(-9px) rotate(3deg)}}
.letter{max-width:760px;margin:auto;padding:clamp(27px,6vw,55px);background:linear-gradient(145deg,#fff8f0,#f9e8ee);color:#493348;border-radius:8px;box-shadow:0 25px 65px #0005;position:relative}
.letter:before{content:"";position:absolute;inset:10px;border:1px solid #d9b5c6;pointer-events:none}
.letter h3{font-size:30px;font-weight:400;margin:0 0 24px;color:#8f5275}.letter p{font-size:17px;line-height:1.85}.letter .sign{font-style:italic;color:#a15c83;margin-top:26px}
.timer{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin:30px 0 5px}.timebox{min-width:75px;padding:15px 12px;border-radius:15px;background:#ffffff0d;border:1px solid #ffffff1b}.timebox strong{display:block;font-size:29px;font-weight:400;color:#ffe2ed}.timebox span{font:9px Arial,sans-serif;letter-spacing:2px;color:var(--muted)}
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:850px;margin:auto}.photo{aspect-ratio:4/5;border:1px dashed #e8b6d466;border-radius:20px;display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;color:#cdb9cc;background:#ffffff08;overflow:hidden;position:relative;font:12px Arial,sans-serif;cursor:pointer}.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.photo span{z-index:1;background:#171126bb;padding:8px 10px;border-radius:20px}
footer{text-align:center;padding:50px 20px 65px;color:#bba8bc;font-size:13px}footer .heart{color:#ff9fc9}
.reveal{opacity:0;transform:translateY(25px);transition:opacity .8s,transform .8s}.reveal.show{opacity:1;transform:none}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:10;overflow:hidden}.piece{position:absolute;top:-15px;width:8px;height:12px;animation:fall 3.5s linear forwards}@keyframes fall{to{transform:translateY(110vh) rotate(760deg);opacity:.2}}
@media(max-width:620px){nav{padding:20px}.gallery{grid-template-columns:1fr 1fr}.gallery .photo:last-child{display:none}section{padding:70px 18px}.cake-card{padding:30px 15px}.bunny{font-size:58px}}
</style>
</head>
<body>
<div id="stars"></div><div id="confetti"></div>
<nav><span class="brand">✦ A LITTLE UNIVERSE</span><a href="#letter">A note for you</a></nav>
<header class="hero">
  <div class="eyebrow">A day made a little more magical</div>
  <h1>Sanvi<span class="sparkle">.</span></h1>
  <p class="subtitle">Today, the universe celebrates you.</p>
  <button class="primary" onclick="document.querySelector('#celebrate').scrollIntoView({behavior:'smooth'})">Open your surprise <span>↗</span></button>
  <div class="scroll">Scroll to explore　↓</div>
</header>

<section id="countdown">
 <div class="section-inner reveal" style="text-align:center">
  <div class="kicker">Save the date</div><h2 class="section-title">The countdown to Sanvi's day</h2>
  <p class="section-copy">A little closer to the day that's all about you.</p>
  <div class="timer" id="birthdayTimer" aria-live="polite">
   <div class="timebox"><strong id="days">00</strong><span>DAYS</span></div>
   <div class="timebox"><strong id="hours">00</strong><span>HOURS</span></div>
   <div class="timebox"><strong id="minutes">00</strong><span>MINUTES</span></div>
   <div class="timebox"><strong id="seconds">00</strong><span>SECONDS</span></div>
  </div>
  <p class="cake-note" id="timerNote">2 December 2026 · The celebration is getting closer ✦</p>
 </div>
</section>

<section id="celebrate">
 <div class="section-inner reveal">
  <div class="kicker">Make a wish</div><h2 class="section-title">A little cake, a lot of wishes.</h2>
  <p class="section-copy">Some moments deserve their own little celebration. Tap the cake and let the magic begin.</p>
  <div class="glass cake-card">
   <div class="cake" id="cake"><div class="candle" style="left:calc(50% - 4px)"><i class="flame"></i></div><div class="tier top"></div><div class="tier mid"></div><div class="tier base"></div></div>
   <button class="primary" id="blow">Make a wish ✦</button>
   <p class="cake-note" id="cakeNote">Tap to make a wish and celebrate</p>
  </div>
 </div>
</section>
<section>
 <div class="section-inner reveal">
  <div class="kicker">A bond worth celebrating</div><h2 class="section-title">Sweet. Bestie. Always there.</h2>
  <p class="section-copy">A little reminder that the best people make ordinary days feel special.</p>
  <div class="glass message-card">
   <div class="bunnies"><span class="bunny">🐰</span><span class="bunny">🐰</span></div>
   <div class="quote">“Some people bring a little more light, laughter and warmth into the world just by being themselves.”</div>
   <div class="signature">— Your friend, always ✦</div>
  </div>
 </div>
</section>
<section id="letter">
 <div class="section-inner reveal">
  <div class="kicker">Just for you</div><h2 class="section-title">A little letter</h2>
  <p class="section-copy">A few words, wrapped up with lots of good wishes.</p>
  <article class="letter">
   <h3>Dear Sanvi,</h3>
   <p>Happy Birthday! I hope this new year of your life brings you beautiful surprises, peaceful days, genuine smiles and countless reasons to feel proud of yourself.</p>
   <p>Keep being your lovely, funny and one-of-a-kind self. May every dream you're quietly working towards find its way to you. And whenever life gets busy, I hope you never forget how much happiness you deserve.</p>
   <p>Here's to new memories, silly conversations, unexpected adventures and a year that feels as special as you are.</p>
   <p class="sign">With lots of good wishes,<br>Your bestie ✨</p>
  </article>
 </div>
</section>
<section>
 <div class="section-inner reveal">
  <div class="kicker">Little memories</div><h2 class="section-title">Moments worth keeping.</h2>
  <p class="section-copy">Add your favourite photos here. They stay on this device while you preview the page.</p>
  <div class="gallery">
   <label class="photo"> <span>＋ Add a memory</span><input type="file" accept="image/*" hidden onchange="addPhoto(this,0)"></label>
   <label class="photo"> <span>＋ Add a memory</span><input type="file" accept="image/*" hidden onchange="addPhoto(this,1)"></label>
   <label class="photo"> <span>＋ Add a memory</span><input type="file" accept="image/*" hidden onchange="addPhoto(this,2)"></label>
  </div>
 </div>
</section>
<section>
 <div class="section-inner reveal" style="text-align:center">
  <div class="kicker">One more thing</div><h2 class="section-title">Your next chapter starts now.</h2>
  <p class="section-copy">May it be full of magic, kindness and moments that make you say, “I’m glad I’m here.”</p>
  <button class="primary" onclick="celebrate()">Celebrate Sanvi ✦</button>
 </div>
</section>
<footer>Made with <span class="heart">♥</span> and a little stardust, just for Sanvi.</footer>
<script>

function updateBirthdayTimer(){
 const now=new Date();
 let target=new Date(now.getFullYear(),11,2,0,0,0);
 if(now.getTime()>target.getTime()) target=new Date(now.getFullYear()+1,11,2,0,0,0);
 const diff=target-now;
 const d=Math.floor(diff/86400000), h=Math.floor(diff/3600000)%24, m=Math.floor(diff/60000)%60, s=Math.floor(diff/1000)%60;
 document.getElementById('days').textContent=String(d).padStart(2,'0');
 document.getElementById('hours').textContent=String(h).padStart(2,'0');
 document.getElementById('minutes').textContent=String(m).padStart(2,'0');
 document.getElementById('seconds').textContent=String(s).padStart(2,'0');
}
updateBirthdayTimer();setInterval(updateBirthdayTimer,1000);

const starRoot=document.getElementById('stars');
for(let i=0;i<95;i++){let s=document.createElement('i');s.className='star';s.style.left=Math.random()*100+'%';s.style.top=Math.random()*100+'%';s.style.animationDelay=Math.random()*4+'s';s.style.opacity=.2+Math.random()*.6;starRoot.appendChild(s)}
const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('show');observer.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
let blown=false;
document.getElementById('blow').addEventListener('click',()=>{blown=!blown;document.getElementById('cake').classList.toggle('cake-off',blown);document.getElementById('cakeNote').textContent=blown?'Wish sent to the universe. May it come true ✨':'Your candles are glowing — make a wish!';document.getElementById('blow').textContent=blown?'Light the candles again':'Make a wish ✦';if(blown)confetti()});
function celebrate(){confetti();document.querySelector('#celebrate').scrollIntoView({behavior:'smooth'})}
function confetti(){const root=document.getElementById('confetti');const colors=['#ff9fc9','#f5d99b','#c9a8ed','#fff7f4','#e88bb8'];for(let i=0;i<95;i++){let p=document.createElement('i');p.className='piece';p.style.left=Math.random()*100+'%';p.style.background=colors[Math.floor(Math.random()*colors.length)];p.style.animationDelay=Math.random()*.9+'s';p.style.transform='rotate('+Math.random()*180+'deg)';root.appendChild(p);setTimeout(()=>p.remove(),4500)}}
function addPhoto(input,index){if(!input.files||!input.files[0])return;const url=URL.createObjectURL(input.files[0]);const box=input.parentElement;let img=box.querySelector('img');if(!img){img=document.createElement('img');box.appendChild(img)}img.src=url;box.querySelector('span').textContent='Change photo'}
</script>
</body>
</html>
